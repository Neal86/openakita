{
  "version": 1,
  "nodes": [
    {
      "id": "hermes-primary",
      "name": "Hermes Primary",
      "base_url": "http://hermes-primary:8000",
      "api_key_env": "HERMES_PRIMARY_API_KEY",
      "enabled": true,
      "priority": 10,
      "weight": 3,
      "capabilities": ["text", "tools"],
      "tags": ["default"],
      "max_concurrency": 8,
      "timeout_seconds": 180
    },
    {
      "id": "hermes-backup",
      "name": "Hermes Backup",
      "base_url": "http://hermes-backup:8000",
      "api_key_env": "HERMES_BACKUP_API_KEY",
      "enabled": true,
      "priority": 20,
      "weight": 1,
      "capabilities": ["text", "tools"],
      "tags": ["backup"],
      "max_concurrency": 4,
      "timeout_seconds": 180
    }
  ]
}
